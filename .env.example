# E.ON Atlassian Data Center — přihlašovací údaje.
#
#     cp .env.example .env && chmod 600 .env
#
# Kde se tokeny zakládají a jak řešit expiraci: README.md.

# --- Jira Data Center ---
JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=

# --- Confluence Data Center ---
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_PERSONAL_TOKEN=

# --- Volitelné: čte je jen mcp-atlassian, skripty v bin/ na ně nesahají ---
# Prázdné = bez filtru, vidíš všechno, na co máš oprávnění.
JIRA_PROJECTS_FILTER=
CONFLUENCE_SPACES_FILTER=

# mcp-atlassian: v0.22.0 změnil default z "all" na 6 core toolsets;
# bez tohohle by po bumpnutí verze polovina z 98 tools zmizela.
TOOLSETS=all
