# ---------------------------------------------------------------------------
# E.ON Atlassian Data Center — přihlašovací údaje
#
# Zkopíruj do .env (které je v .gitignore) a doplň tokeny:
#     cp .env.example .env && chmod 600 .env
#
# Tokeny se vytvářejí ručně ve webovém UI (vyžaduje tvoje přihlášení):
#   Jira:       https://track.eon.cz/secure/ViewProfile.jspa  → Personal Access Tokens
#   Confluence: https://dory.eon.cz/users/viewmyprofile.action → Personal access tokens
#
# POZOR: PAT v Data Center má povinnou expiraci (default 90 dní).
# Datum expirace si zapiš — po vypršení tokenu selže MCP i skripty.
# ---------------------------------------------------------------------------

# --- Jira Data Center 10.3.23 ---
JIRA_URL=https://track.eon.cz
JIRA_PERSONAL_TOKEN=

# --- Confluence Data Center ---
CONFLUENCE_URL=https://dory.eon.cz
CONFLUENCE_PERSONAL_TOKEN=

# --- Volitelné: zúžení rozsahu (zmenšuje šum ve výsledcích hledání) ---
# Prázdné = bez filtru, vidíš všechno, na co máš oprávnění.
JIRA_PROJECTS_FILTER=
CONFLUENCE_SPACES_FILTER=
