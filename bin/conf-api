#!/usr/bin/env bash
# Tenký klient nad Confluence Data Center REST API (v1, /rest/api).
#
# Použití:
#   bin/conf-api GET /user/current
#   bin/conf-api GET '/space?limit=50'
#   bin/conf-api GET '/content/search?cql=text~"AIC"&limit=10'
#   bin/conf-api GET '/content/123456?expand=body.storage,version'
#   bin/conf-api POST /content -d @page.json
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
set -e   # po sourcování, aby ho _common.sh nepřepsal

[[ $# -ge 2 ]] || { usage_from_header "$0"; exit 2; }

load_env
require_var CONFLUENCE_URL
require_var CONFLUENCE_PERSONAL_TOKEN

method="$1"; path="$2"; shift 2
[[ "$path" == /* ]] || path="/$path"

atl_curl "${CONFLUENCE_URL}/rest/api" "$CONFLUENCE_PERSONAL_TOKEN" "$method" "$path" "$@"
